// title: Sailor Song
// artist: Gigi Perez
// audio: 04-sailor-song.mp3
// Instrumental rendition — no lyrics, just the gentle lilt.

setcps(80/60/4)

// melody — soft and lilting (6/8 feel)
$: cat(
  note("f#4@6 ~@3 a#4@3"),
  note("b4@3 a#4@3 f#4@6"),
  note("c#5@6 ~@3 b4@3"),
  note("a#4@3 g#4@3 f#4@6"),
  note("d#5@3 c#5@3 b4@6"),
  note("a#4@6 ~@6")
).s("triangle").gain(.3).attack(.03).release(.45).room(.55).delay(.15)

// pad — F# B D#m C#
$: note("<[f#3,a#3,c#4] [b3,d#4,f#4] [d#3,f#3,a#3] [c#3,f3,g#3]>")
  .s("triangle").attack(.2).release(.6).gain(.13).room(.6)

// strummed chords
$: note("<[f#3,a#3,c#4] [b3,d#4,f#4] [d#3,f#3,a#3] [c#3,f3,g#3]>")
  .ply(2).s("triangle").lpf(2200).attack(.01).release(.3).gain(.1)

// bass
$: note("<f#2*2 b1*2 d#2*2 c#2*2>").s("sawtooth").lpf(380).legato(.9).gain(.42)

// soft drums
$: s("<[bd ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~] [bd ~ ~ bd ~ ~]>").bank("RolandTR909").gain(.55)

$: s("<[~ ~ ~ sd ~ ~] [~ ~ ~ sd ~ ~] [~ ~ ~ sd ~ ~] [~ ~ ~ sd ~ sd]>").bank("RolandTR909").gain(.3).room(.35)

$: s("hh*6").bank("RolandTR909").gain(.09)

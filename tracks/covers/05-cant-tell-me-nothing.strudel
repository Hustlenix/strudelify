$: new Pattern(state => sourceBassNotes.flatMap(([a,b,n]) => {
  const whole = new TimeSpan(a*(80/240),b*(80/240))
  const part = whole.intersection(state.span)
  return part ? [new Hap(whole,part,{note:n})] : []
})).s("sine").lpf(160).attack(.008).decay(.08).sustain(.7).release(.06).gain(.8)

// stomp
$: s("<[bd ~ bd ~] [bd ~ bd ~] [bd ~ bd ~] [bd ~ bd bd]>").bank("RolandTR909").gain(.85)

$: s("~ cp ~ cp").bank("RolandTR909").gain(.4).room(.25)

$: s("hh*4").bank("RolandTR909").gain(.18)

// Measured mix headroom: baseline peak 1.84 dBFS; retain layer balance.
all(p => p.withValue(v => ({...v, gain: (v.gain ?? 1) * 0.55})))


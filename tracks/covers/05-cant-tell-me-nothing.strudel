// title: Can't Tell Me Nothing
// artist: Kanye West
// audio: 05-cant-tell-me-nothing.mp3
// Instrumental rendition — no lyrics, just the stadium stomp.

setcps(80/60/4)

// pad — F#m D A E
$: note("<[f#3,a3,c#4]*2 [d3,f#3,a3]*2 [a3,c#4,e4]*2 [e3,g#3,b3]*2>")
  .s("supersaw").lpf(1500).attack(.15).release(.7).gain(.2).room(.5)

// lead — sparse and triumphant
$: cat(
  note("f#4@4 a4@4 c#5@4 b4@4"),
  note("a4@8 ~@8"),
  note("f#4@4 a4@4 c#5@4 e5@4"),
  note("c#5@8 ~@4 b4@4")
).s("sawtooth").lpf(2200).gain(.26).attack(.02).release(.3).delay(.2)

// 808 bass
$: note("<[f#1 ~ ~ f#1 ~ ~ f#1 ~] [d1 ~ ~ d1 ~ ~ d1 ~] [a1 ~ ~ a1 ~ ~ a1 ~] [e1 ~ ~ e1 ~ ~ e1 ~]>")
  .s("sine").lpf(160).legato(.9).gain(.8)

// stomp
$: s("<[bd ~ bd ~] [bd ~ bd ~] [bd ~ bd ~] [bd ~ bd bd]>").bank("RolandTR909").gain(.85)

$: s("~ cp ~ cp").bank("RolandTR909").gain(.4).room(.25)

$: s("hh*4").bank("RolandTR909").gain(.18)

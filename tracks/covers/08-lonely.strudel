// title: Lonely
// artist: Akon
// audio: 08-lonely.mp3
// Music audit: -1 semitone tonal correction; see music-audit/reports/adjustments.json
// Instrumental rendition — no lyrics, just the sad whistle.

setcps(90/60/4)

// lead — mournful
$: cat(
  note("c5@4 g#4@4 f4@8"),
  note("~@4 f4@2 g4@2 g#4@8"),
  note("a#4@4 g#4@4 g4@4 f4@4"),
  note("f4@8 ~@8")
).s("sine").gain(.34).attack(.05).release(.5).room(.5).delay(.3)

// pad — baseline voicing sequence retained; harmonic changes still require review.
$: note("<[f3,g#3,c4] [c#3,f3,g#3] [a#2,c#3,f3] [c3,e3,g3]>")
  .s("triangle").attack(.15).release(.6).gain(.14).room(.5)

// bass
$: note("<f2*2 c#2*2 a#1*2 c2*2>").s("sawtooth").lpf(360).legato(.9).gain(.5)

// drums — slow and soft
$: s("<[bd ~ ~ ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~]>").bank("RolandTR909").gain(.6)

$: s("<[~ ~ ~ ~ ~ ~ sd ~] [~ ~ ~ ~ ~ ~ sd ~] [~ ~ ~ ~ ~ ~ sd ~] [~ ~ ~ ~ ~ ~ sd sd]>").bank("RolandTR909").gain(.3).room(.4)

$: s("hh*8").bank("RolandTR909").gain(.1)

// title: I Thought I Saw Your Face Today
// artist: She & Him
// audio: 07-i-thought-i-saw-your-face-today.mp3
// Music audit: +5 semitone tonal correction; see music-audit/reports/adjustments.json
// Instrumental rendition — no lyrics, just the vintage bounce.

setcps(78/60/4)

// melody — sweet and doo-woppy
$: cat(
  note("~@4 g4@2 a4@2 b4@4 a4@4"),
  note("g4@8 ~@8"),
  note("b4@2 a4@2 g4@4 e4@4 f#4@4"),
  note("g4@8 ~@8"),
  note("e5@4 d5@2 c5@2 d5@4 e5@4"),
  note("d5@8 ~@8"),
  note("g5@2 f#5@2 e5@4 d5@4 c5@4"),
  note("b4@8 ~@8")
).s("triangle").gain(.3).attack(.01).release(.28).room(.35).delay(.12)

// chords — baseline voicing sequence retained; harmonic changes still require review.
$: note("<[g3,b3,d4] [e3,g3,b3] [c4,e4,g4] [d4,f#4,a4]>")
  .s("triangle").attack(.04).release(.3).gain(.14).room(.3)

// bass
$: note("<g2*4 e2*4 c3*4 d3*4>").s("sawtooth").lpf(460).legato(.7).gain(.45)

// drums — vintage LinnDrum
$: s("<[bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ bd]>").bank("LinnDrum").gain(.75)

$: s("~ ~ sd ~ ~ ~ sd ~").bank("LinnDrum").gain(.45).room(.2)

$: s("hh*8").bank("LinnDrum").gain(.2)

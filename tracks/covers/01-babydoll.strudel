// title: Babydoll
// artist: Dominic Fike
// audio: 01-babydoll.mp3
// Instrumental rendition — no lyrics, just groove, chords and melody.

setcps(84.05/60/4)

// hook — melody
$: cat(
  note("~@8 b3@2 d4@2 e4@2 ~@2"),
  note("~@4 d4@2 e4@2 d4@2 b3@2 ~@4"),
  note("b3@2 d4@2 g4@4 e4@2 d4@4 ~@2"),
  note("~@4 e4@2 d4@2 b3@2 a3@2 ~@4"),
  note("~@8 b3@2 d4@2 e4@2 ~@2"),
  note("~@4 g4@2 f#4@2 e4@2 d4@2 ~@4"),
  note("e4@2 f#4@2 g4@2 a4@2 b4@4 ~@4"),
  note("~@6 d4@2 b3@2 a3@2 ~@4")
).s("triangle").lpf(3200).gain(.36).attack(.01).release(.22).room(.35)

// chords — G D Em C
$: note("<[g3,b3,d4] [d3,f#3,a3] [e3,g3,b3] [c3,e3,g3]>")
  .s("triangle").lpf(1400).attack(.08).release(.35).gain(.15).room(.45)

// bass — walks up through the changes
$: note("<[g2 ~ g2 ~ g2 ~ b2 d3] [d2 ~ d2 ~ d2 ~ a2 d3] [e2 ~ e2 ~ e2 ~ g2 b2] [c2 ~ c2 ~ c2 ~ e2 g2]>")
  .s("sawtooth").lpf(520).legato(.7).gain(.5)

// drums — soft boom bap
$: s("<[bd ~ sd ~ bd ~ sd ~] [bd ~ sd ~ bd ~ [sd sd] ~]>").bank("RolandTR909").gain(.7)

$: s("hh*8").bank("RolandTR909").gain(.16)

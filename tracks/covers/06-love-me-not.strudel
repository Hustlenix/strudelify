// title: Love Me Not
// artist: Ravyn Lenae
// audio: 06-love-me-not.mp3
// Music audit: +4 semitone tonal correction; see music-audit/reports/adjustments.json
// Instrumental rendition — no lyrics, just the dreamy drift.

setcps(114/60/4)

// melody — airy
$: cat(
  note("~@4 e5@2 g5@2 e5@4 c5@4"),
  note("~@2 d5@2 e5@2 g5@2 ~@8"),
  note("f5@4 e5@2 d5@2 c5@8"),
  note("~@4 g5@2 e5@2 d5@2 c5@2 ~@4")
).s("sine").gain(.32).attack(.03).release(.5).room(.6).delay(.2)

// chords — baseline voicing sequence retained; harmonic changes still require review.
$: note("<[c4,e4,g4] [a3,c4,e4] [f3,a3,c4] [g3,b3,d4]>")
  .s("triangle").attack(.06).release(.5).gain(.16).room(.7).delay(.15)

// bass
$: note("<c2*2 a2*2 f2*2 g2*2>").s("sine").lpf(180).legato(.9).gain(.6)

// drums — soft
$: s("<[bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ bd]>").bank("RolandTR808").gain(.6)

$: s("~ ~ sd ~ ~ ~ sd ~").bank("RolandTR808").gain(.35).room(.35)

$: s("hh*8").bank("RolandTR808").gain(.13)

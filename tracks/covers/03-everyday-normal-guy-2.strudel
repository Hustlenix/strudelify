// title: Everyday Normal Guy 2
// artist: Jon Lajoie
// audio: 03-everyday-normal-guy-2.mp3
// Instrumental rendition — no lyrics, just the comfy loop.

setcps(90/60/4)

// goofy little lead
$: cat(
  note("a3@4 c4@4 a3@4 g3@4"),
  note("e3@4 g3@4 a3@8"),
  note("f3@4 a3@4 c4@4 a3@4"),
  note("g3@4 e3@4 a3@8")
).s("square").lpf(1400).gain(.2).attack(.02).release(.12).room(.25)

// chords — Am G F G
$: note("<[a3,c4,e4] [g3,b3,d4] [f3,a3,c4] [g3,b3,d4]>")
  .s("triangle").attack(.06).release(.3).gain(.14).room(.3)

// bass
$: note("<a2*4 g2*4 f2*4 g2*4>").s("sawtooth").lpf(500).legato(.7).gain(.5)

// drums — simple boom bap
$: s("<[bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ ~] [bd ~ ~ ~ bd ~ ~ bd]>").bank("RolandTR808").gain(.8)

$: s("~ ~ sd ~ ~ ~ sd ~").bank("RolandTR808").gain(.45).room(.2)

$: s("hh*8").bank("RolandTR808").gain(.18)

// Measured macro-dynamics from the supplied recording; no inferred verse/chorus labels.
// One-second RMS, three-second smoothing, square-root dynamic compression, gain <=1.
// This follows source energy and ends the arrangement; it does not certify section orchestration.
const sourceDynamics = [0.05,0.0736,0.2339,0.3811,0.5141,0.6312,0.6632,0.681,0.6888,0.7819,0.8515,0.8224,0.8027,0.7938,0.8946,0.8462,0.8469,0.8526,0.9163,0.9333,0.9106,0.9397,0.9683,0.9033,0.8953,0.9071,0.9672,0.9785,0.9738,0.9992,1.0,0.9507,0.9618,0.9803,1.0,1.0,0.9748,0.9651,0.9883,0.9798,0.988,0.9914,0.9877,0.9756,0.9368,0.9448,0.9711,0.9447,0.9416,0.9532,0.9731,0.9778,0.9539,0.96,0.9807,0.9123,0.922,0.9262,0.9634,0.9521,0.9402,0.9563,0.9823,0.9208,0.9382,0.9635,0.9838,0.9672,0.9365,0.9566,0.9855,0.9283,0.9373,0.9488,0.9842,0.9919,0.9816,0.9866,0.9908,0.9339,0.9637,0.9851,1.0,1.0,0.9664,0.9855,1.0,0.9837,0.9624,0.9533,0.977,1.0,1.0,1.0,1.0,0.9395,0.921,0.9215,0.9483,0.9743,0.963,0.9728,0.9785,0.91,0.9224,0.9347,0.9819,0.9849,0.9711,0.9765,0.9957,0.9546,0.9656,0.9653,0.9775,0.9878,0.9701,0.9823,0.9818,0.9404,0.9649,0.9638,0.9608,0.9354,0.9224,0.9239,0.945,0.8764,0.8972,0.9077,0.9286,0.937,0.9152,0.9524,0.9798,0.9418,0.9457,0.9404,0.9584,0.9659,0.9531,0.964,0.9766,0.9342,0.9419,0.9477,0.9514,0.9441,0.921,0.9432,0.9688,0.9116,0.9217,0.9307,0.9653,0.9621,0.9508,0.972,1.0,0.9542,0.9736,0.9901,1.0,0.9854,0.9508,0.9537,0.9723,0.9697,0.9816,0.9892,0.9827,0.9709,0.9756,0.9717,0.9974,0.9408,0.948,0.9546,0.9456,0.9406,0.9162,0.9368,0.9612,0.9049,0.9127,0.9083,0.931,0.9204,0.9072,0.9209,0.9519,0.8944,0.9176,0.9419,0.9594,0.9452,0.8943,0.9149,0.9322,0.8732,0.8664,0.8777,0.9082,0.9045,0.8627,0.7218,0.5132,0.05,0.1737,0.3256,0.459,0.5848,0.6493,0.6831,0.6871,0.7456,0.8297,0.9106,0.9235,0.8239,0.6104,0.334]
const sourceDuration = 221.256
const musicCps = 0.375
const sourceLevelAt = seconds => {
  const i = Math.max(0, Math.min(sourceDynamics.length - 1, Math.floor(seconds)))
  const a = sourceDynamics[i], b = sourceDynamics[Math.min(i + 1, sourceDynamics.length - 1)]
  return a + (b - a) * Math.max(0, Math.min(1, seconds - i))
}
all(p => p.filterHaps(h => Number(h.whole.begin) < sourceDuration * musicCps)
  .withHap(h => h.withValue(v => ({...v, gain: (v.gain ?? 1) * sourceLevelAt(Number(h.whole.begin) / musicCps)}))))
